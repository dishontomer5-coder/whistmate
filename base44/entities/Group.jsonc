{
  "name": "Group",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Group Name",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "title": "Description",
      "default": ""
    },
    "invite_code": {
      "type": "string",
      "title": "Invite Code",
      "description": "6-char uppercase alphanumeric join code. Unique. Indexed for O(1) lookup.",
      "unique": true,
      "index": true
    },
    "advanced_rules_default": {
      "type": "boolean",
      "title": "Advanced Rules Default",
      "default": false,
      "description": "Default for new sessions: whether the highest bidder assigns trump suit + hierarchy. Frozen onto each Session at creation."
    },
    "scoring_method_default": {
      "type": "string",
      "enum": [
        "classic",
        "progressive"
      ],
      "default": "classic",
      "title": "Scoring Method Default",
      "description": "Default missed-contract penalty scheme for new sessions. 'classic' = -10/trick; 'progressive' = escalating per miss size. Frozen onto each Session at creation."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ],
      "default": "active",
      "title": "Status",
      "description": "Lifecycle status. 'active' = fully usable. 'archived' = read-only, stats still count globally. 'deleted' = soft-deleted, excluded from all stats and queries. Indexed for filtering.",
      "index": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
