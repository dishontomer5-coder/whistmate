{
  "name": "GroupMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "title": "Group ID",
      "description": "FK to Group entity. Indexed for member listing queries.",
      "index": true
    },
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "FK to User entity. Nullable — null means ghost member (unclaimed profile). Indexed for membership lookup.",
      "default": null,
      "index": true
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "player"
      ],
      "default": "player",
      "title": "Role"
    },
    "player_name": {
      "type": "string",
      "title": "Player Name",
      "minLength": 1,
      "description": "Display name within this group. Uniqueness within (group_id, player_name) enforced at application level in backend functions to prevent duplicate ghost entries and naming collisions."
    },
    "joined_date": {
      "type": "string",
      "format": "date-time",
      "title": "Joined Date"
    },
    "claimed": {
      "type": "boolean",
      "title": "Claimed",
      "default": false,
      "description": "False for ghost members (no app account). Set to true when a user completes the claim flow."
    },
    "claim_token": {
      "type": "string",
      "title": "Claim Token",
      "default": null,
      "description": "Unique token for profile-claim invitations. Indexed for claim flow lookup. Null after claim is completed.",
      "index": true
    }
  },
  "required": [
    "group_id",
    "player_name",
    "role"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}
